# Copy to .env and fill in. Never commit real keys.
# LLM provider selection: groq | none (default: none -> rule-based demo mode)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Relational DB for batches/results/reviews (SQLite file, no server needed).
DATABASE_URL=sqlite:///data/quality.db

# Vector store (ChromaDB persistent dir, no server needed).
CHROMA_DIR=data/chroma

# App
API_HOST=127.0.0.1
API_PORT=8000
MAX_WORKFLOW_RETRIES=3
CSV_PATH=data/quality_batches.csv
LIMITS_PATH=config/demo_quality_limits.yaml
SOPS_DIR=data/sops
